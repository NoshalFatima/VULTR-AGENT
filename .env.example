# Control VM (/etc/agent/control.env) - created by deploy/setup_control.sh
RUNNER_URL=http://10.x.x.x:8001
RUNNER_SECRET=change-me-long-random
SESSION_SECRET=change-me-long-random
LLM_PROVIDER=vultr
VULTR_INFERENCE_API_KEY=your-vultr-inference-key
MODEL=kimi-k2-instruct
ACCESS_CODE=optional-demo-code
BROWSER_ALLOWLIST=example.com,wikipedia.org
